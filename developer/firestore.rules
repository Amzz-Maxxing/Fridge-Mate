rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validUnit(d) {
      return !('unit' in d) || d.unit in ['pcs', 'pack', 'g', 'kg', 'ml', 'L'];
    }

    match /users/{uid} {
      allow read, write: if signedInAs(uid);

      // Fridge items
      match /inventory/{itemId} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid) && validInventory(request.resource.data);
      }

      // Smart grocery list
      match /groceryList/{itemId} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid) && validGrocery(request.resource.data);
      }

      // Saved grocery lists (e.g. "Monthly groceries")
      match /savedLists/{listId} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid) && validSavedList(request.resource.data);
      }

      // Shopping history (one document per trip)
      match /shoppingTrips/{tripId} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid) && validTrip(request.resource.data);
      }

      // Weekly meal plans (Premium); the document id is the week's Monday
      match /mealPlans/{weekId} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
            && request.resource.data.keys().hasOnly(['meals', 'updatedAt'])
            && request.resource.data.meals is map
            && request.resource.data.meals.size() <= 21;
      }

      // Favourite recipes; the document id is the recipe id
      match /favourites/{recipeId} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
            && recipeId.size() <= 60
            && request.resource.data.keys().hasOnly(['addedAt']);
      }
    }

    function validInventory(d) {
      return d.keys().hasOnly(['name', 'quantity', 'unit', 'category', 'expiryDate',
                               'purchaseDate', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.quantity is number && d.quantity > 0
          && validUnit(d)
          && d.category is string
          && d.expiryDate is timestamp;
    }

    function validGrocery(d) {
      return d.keys().hasOnly(['name', 'keywords', 'quantity', 'unit',
                               'fromRecipe', 'checked', 'boughtViaReceipt',
                               'createdAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.checked is bool
          && (!('quantity' in d) || (d.quantity is number && d.quantity > 0))
          && validUnit(d)
          && (!('keywords' in d) || (d.keywords is list && d.keywords.size() <= 20))
          && (!('fromRecipe' in d) || d.fromRecipe is string);
    }

    // No prices or payment details are ever stored.
    function validTrip(d) {
      return d.keys().hasOnly(['date', 'store', 'source', 'items', 'createdAt'])
          && d.date is timestamp
          && d.source in ['receipt', 'list']
          && (!('store' in d) || (d.store is string && d.store.size() <= 80))
          && d.items is list && d.items.size() > 0 && d.items.size() <= 200;
    }

    function validSavedList(d) {
      return d.keys().hasOnly(['name', 'items', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.items is list && d.items.size() <= 200;
    }
  }
}
